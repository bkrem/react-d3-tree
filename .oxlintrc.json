{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "jsx-a11y", "import", "typescript", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "vitest": true
  },
  "rules": {
    "no-console": "warn",
    "no-unused-expressions": "warn",
    "no-unused-vars": "warn",
    "prefer-template": "warn",
    "vitest/no-disabled-tests": "warn"
  },
  "overrides": [
    {
      "files": ["scripts/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": ["lib", "coverage", "demo/dist", "demo/public", "node_modules"]
}
