{
  "name": "react-d3-tree",
  "version": "3.7.0-rc.0",
  "description": "React component to create interactive D3 tree hierarchies",
  "author": "Ben Kremer",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bkrem/react-d3-tree/issues"
  },
  "homepage": "https://github.com/bkrem/react-d3-tree",
  "files": [
    "lib"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build:docs": "typedoc",
    "build": "node scripts/clean.ts lib && tsc -p tsconfig.json",
    "build:watch": "node scripts/clean.ts lib && tsc -p tsconfig.json -w",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint src scripts test",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "test": "vitest run --coverage",
    "test:smoke": "node scripts/smoke-test.ts",
    "test:clean": "node scripts/clean.ts coverage",
    "test:watch": "vitest",
    "check:package": "node scripts/check-package.ts",
    "show:cov": "open coverage/lcov-report/index.html",
    "show:docs": "open demo/public/docs/index.html",
    "prepare": "husky 1>&2 || true",
    "prepublishOnly": "pnpm run test && pnpm run build",
    "deploy:demo": "pnpm run build && pnpm run build:docs && cd demo && npm run build && npm run deploy"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bkrem/react-d3-tree.git"
  },
  "keywords": [
    "react",
    "d3",
    "tree",
    "component",
    "graph",
    "svg",
    "hierarchical-data",
    "hierarchy",
    "d3-visualization",
    "chart"
  ],
  "dependencies": {
    "@bkrem/react-transition-group": "^1.3.5",
    "@types/d3-hierarchy": "^1.1.8",
    "clone": "^2.1.1",
    "d3-hierarchy": "^1.1.9",
    "d3-selection": "^3.0.0",
    "d3-shape": "^1.3.7",
    "d3-zoom": "^3.0.0",
    "dequal": "^2.0.2"
  },
  "peerDependencies": {
    "react": "16.x || 17.x || 18.x || 19.x",
    "react-dom": "16.x || 17.x || 18.x || 19.x"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3-selection": "^1.4.3",
    "@types/d3-shape": "^1.3.5",
    "@types/d3-zoom": "^1.8.2",
    "@types/node": "^24.13.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^5.0.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "publint": "^0.3.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
