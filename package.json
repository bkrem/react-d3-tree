{
  "name": "react-d3-tree",
  "version": "3.6.7-rc.1",
  "description": "React component to create interactive D3 tree hierarchies",
  "author": "Ben Kremer",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bkrem/react-d3-tree/issues"
  },
  "homepage": "https://github.com/bkrem/react-d3-tree",
  "files": [
    "lib"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js",
      "types": "./lib/types/index.d.ts"
    }
  },
  "module": "lib/esm/index.js",
  "main": "lib/cjs/index.js",
  "types": "lib/types/index.d.ts",
  "scripts": {
    "build:docs": "rimraf ./docs && typedoc",
    "build:cjs": "tsc -p tsconfig.json && node scripts/mark-cjs.js",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build": "rimraf lib && pnpm run build:cjs && pnpm run build:esm",
    "build:watch": "rimraf lib && tsc -p tsconfig.esm.json -w",
    "lint": "eslint src/**/*.js",
    "test": "jest --config jest.config.json --coverage --verbose",
    "test:smoke": "node scripts/smoke-test.js",
    "test:clean": "rimraf ./coverage",
    "test:watch": "jest --config jest.config.json --watchAll",
    "test:cov": "jest --config jest.config.json --coverage --verbose",
    "coveralls": "cat ./coverage/lcov.info | coveralls",
    "show:cov": "open coverage/lcov-report/index.html",
    "show:docs": "open demo/public/docs/index.html",
    "prepare": "husky 1>&2 || true",
    "prepublishOnly": "pnpm run test && pnpm run build",
    "deploy:demo": "pnpm run build && pnpm run build:docs && cd demo && npm run build && npm run deploy"
  },
  "packageManager": "pnpm@12.4.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/bkrem/react-d3-tree.git"
  },
  "keywords": [
    "react",
    "d3",
    "tree",
    "component",
    "graph",
    "svg",
    "hierarchical-data",
    "hierarchy",
    "d3-visualization",
    "chart"
  ],
  "dependencies": {
    "@bkrem/react-transition-group": "^1.3.5",
    "@types/d3-hierarchy": "^1.1.8",
    "clone": "^2.1.1",
    "d3-hierarchy": "^1.1.9",
    "d3-selection": "^3.0.0",
    "d3-shape": "^1.3.7",
    "d3-zoom": "^3.0.0",
    "dequal": "^2.0.2"
  },
  "peerDependencies": {
    "react": "16.x || 17.x || 18.x || 19.x",
    "react-dom": "16.x || 17.x || 18.x || 19.x"
  },
  "devDependencies": {
    "@babel/core": "^7.8.3",
    "@babel/plugin-proposal-class-properties": "^7.8.3",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-react": "^7.8.3",
    "@babel/preset-typescript": "^7.8.3",
    "@types/d3-selection": "^1.4.3",
    "@types/d3-shape": "^1.3.5",
    "@types/d3-zoom": "^1.8.2",
    "@types/react": "^16.9.17",
    "babel-eslint": "^10.0.3",
    "babel-jest": "^24.9.0",
    "coveralls": "^3.0.0",
    "enzyme": "^3.4.4",
    "enzyme-adapter-react-16": "^1.2.0",
    "eslint": "4.16.0",
    "eslint-config-airbnb": "^16.1.0",
    "eslint-config-prettier": "^3.3.0",
    "eslint-plugin-import": "^2.2.0",
    "eslint-plugin-jsx-a11y": "^6.0.2",
    "eslint-plugin-react": "^7.5.1",
    "husky": "^9.1.7",
    "jest": "^24.9.0",
    "lint-staged": "^17.5.1",
    "prettier": "^1.19.1",
    "react": "^16.14.0",
    "react-dom": "^16.6.3",
    "react-test-renderer": "^16.6.3",
    "regenerator-runtime": "^0.12.0",
    "rimraf": "^3.0.0",
    "ts-jest": "^24.0.2",
    "ts-node": "^8.3.0",
    "tsconfig-paths": "^3.8.0",
    "typedoc": "^0.27.6",
    "typescript": "~5.9.3"
  }
}
