</path>
<path style="opacity: 1;" class="rd3t-link" d="M140,-70C210,-70,210,-140,280,-140" data-source-id="ID" data-target-id="ID">
</path>
<path style="opacity: 1;" class="rd3t-link" d="M140,-70C210,-70,210,0,280,0" data-source-id="ID" data-target-id="ID">
</path>
<g id="ID" style="opacity: 1;" class="rd3t-node root-x" transform="translate(0,0)">
<circle r="15">
</circle>
<g class="rd3t-label">
<text class="rd3t-label__title" text-anchor="start" x="40">Top Level</text>
<text class="rd3t-label__attributes">
<tspan x="40" dy="1.2em">keyA: val A</tspan>
<tspan x="40" dy="1.2em">keyB: val B</tspan>
<tspan x="40" dy="1.2em">keyC: val C</tspan>
</text>
</g>
</g>
<g id="ID" style="opacity: 1;" class="rd3t-node branch-x" transform="translate(140,-70)">
<circle r="15">
</circle>
<g class="rd3t-label">
<text class="rd3t-label__title" text-anchor="start" x="40">2: A</text>
<text class="rd3t-label__attributes">
<tspan x="40" dy="1.2em">keyA: val A</tspan>
<tspan x="40" dy="1.2em">keyB: val B</tspan>
<tspan x="40" dy="1.2em">keyC: val C</tspan>
</text>
</g>
</g>
<g id="ID" style="opacity: 1;" class="rd3t-leaf-node leaf-x" transform="translate(140,70)">
<circle r="15">
</circle>
<g class="rd3t-label">
<text class="rd3t-label__title" text-anchor="start" x="40">2: B</text>
<text class="rd3t-label__attributes">
</text>
</g>
</g>
<g id="ID" style="opacity: 1;" class="rd3t-leaf-node leaf-x" transform="translate(280,-140)">
<circle r="15">
</circle>
<g class="rd3t-label">
<text class="rd3t-label__title" text-anchor="start" x="40">3: Son of A</text>
<text class="rd3t-label__attributes">
<tspan x="40" dy="1.2em">keyA: val A</tspan>
<tspan x="40" dy="1.2em">keyB: val B</tspan>
<tspan x="40" dy="1.2em">keyC: val C</tspan>
</text>
</g>
</g>
