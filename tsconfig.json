{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",
    "lib": ["dom", "es2020"],
    "types": [],
    "jsx": "react-jsx",
    "strict": true,
    "rootDir": "./src",
    "outDir": "./lib",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/tests/*", "**/*.test.ts", "**/*.test.tsx"]
}
