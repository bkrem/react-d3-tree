{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es5",
    "lib": ["dom", "es2017"],
    "types": [],
    "jsx": "react",
    "outDir": "./lib/cjs",
    "declaration": true,
    "declarationDir": "./lib/types",
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/tests/*", "**/*.test.ts", "**/*.test.tsx"]
}
